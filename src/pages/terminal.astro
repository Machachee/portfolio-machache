---
import "../styles/terminal.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Terminal CV | Dani Ramos Merino - Full Stack Developer</title>
    <meta name="description" content="CV interactivo en formato terminal de Dani Ramos Merino, Desarrollador Full Stack. Comandos: help, about, skills, experience, projects, contact." />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Dani Ramos Merino" />
    <link rel="canonical" href="https://machache.vercel.app/terminal" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://machache.vercel.app/terminal" />
    <meta property="og:title" content="Terminal CV | Dani Ramos Merino" />
    <meta property="og:description" content="CV interactivo en formato terminal con comandos retro, snake, matrix y más." />
    <meta property="og:image" content="https://machache.vercel.app/image/avatar.png" />
    <meta property="og:locale" content="es_ES" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      integrity="sha384-iw3OoTErCYJJB9mCa8LNS2hbsQ7M3C0EpIsO/H5+EGAkPGc6rk+V8i04oW/K5xq0"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.6.0/p5.min.js"
      integrity="sha384-KuaSButcSBcmbzC19JLv+LljKIziQQ7lTOUg37f83huBz49+tWag9p61U1SONpzA"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    ></script>
  </head>
  <body>
    <div class="terminal">
      <div class="terminal-header">
        <div class="terminal-buttons">
          <span class="close"></span>
          <span class="minimize"></span>
          <span class="maximize"></span>
        </div>
        <div class="terminal-title">dani@machache: ~/resume</div>
        <div class="terminal-controls">
          <div class="theme-selector">
            <i class="fa-solid fa-palette" id="theme-toggle"></i>
          </div>
        </div>
      </div>
      <div class="terminal-container">
        <div class="terminal-content">
          <div id="output"></div>
          <div class="input-line">
            <span class="prompt">➜</span>
            <input type="text" id="command-input" autofocus />
          </div>
        </div>
      </div>
      <div class="terminal-footer">
        <a href="/" class="resume-link"><i class="fas fa-file-alt"></i> View Portfolio</a>
        <a href="/" class="resume-link"><i class="fas fa-shapes"></i> Neo-Brutalism Resume</a>
      </div>
      <div class="context-menu">
        <div class="menu-item" data-action="split-h">Split Horizontally</div>
        <div class="menu-item" data-action="split-v">Split Vertically</div>
        <div class="menu-item" data-action="close-split">Close Split</div>
      </div>
    </div>

    <div id="theme-modal" class="modal">
      <div class="modal-content">
        <span class="close-button">&times;</span>
        <h2>Select Theme</h2>
        <div class="theme-options">
          <div class="theme-option" data-theme="default">
            <div class="theme-preview default-theme"></div>
            <span>Default</span>
          </div>
          <div class="theme-option" data-theme="dracula">
            <div class="theme-preview dracula-theme"></div>
            <span>Dracula</span>
          </div>
          <div class="theme-option" data-theme="solarized">
            <div class="theme-preview solarized-theme"></div>
            <span>Solarized</span>
          </div>
          <div class="theme-option" data-theme="nord">
            <div class="theme-preview nord-theme"></div>
            <span>Nord</span>
          </div>
        </div>
      </div>
    </div>

    <div id="projects-modal" class="modal">
      <div class="modal-content projects-modal-content">
        <span class="close-button">&times;</span>
        <h2>Projects</h2>
        <div class="projects-container"></div>
      </div>
    </div>

    <div id="skills-modal" class="modal">
      <div class="modal-content skills-modal-content">
        <span class="close-button">&times;</span>
        <h2>Skills Visualization</h2>
        <div class="skills-container"></div>
      </div>
    </div>

    <script>
      import "../scripts/terminal.js";
    </script>
  </body>
</html>
