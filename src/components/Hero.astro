---
---
<section class="hero" id="hero">
  <div class="hero-content">
    <div class="hero-left">
      <p class="hero-greeting" id="hero-greeting" data-i18n="hero.greeting">¡Hola! 👋</p>
      <h1 class="hero-name" data-i18n="hero.name">Soy Dani Ramos.</h1>
      <p class="hero-description" data-i18n="hero.description">
        Desarrollador Full Stack basado en Valladolid, España. Construyo soluciones web seguras y escalables: desde
        arquitecturas WordPress Headless con Next.js + WPGraphQL hasta e-commerce a medida (WooCommerce, PrestaShop).
        +4 años de producción, +20 proyectos entregados y estudiante de Ingeniería Informática en la UOC.
      </p>
      <div class="hero-social">
        <a href="https://github.com/machachee" target="_blank" class="social-btn"><i class="fab fa-github"></i></a>
        <a href="https://www.linkedin.com/in/daniramosmerino/" target="_blank" class="social-btn"><i class="fab fa-linkedin"></i></a>
        <a href="mailto:ramosmerinodaniel@gmail.com" class="social-btn"><i class="fas fa-envelope"></i></a>
      </div>
      <div class="hero-cta-container">
        <a href="#contact" class="btn-cta" data-i18n="hero.cta">¡Hablemos!</a>
      </div>
    </div>
    <div class="hero-right">
      <div class="hero-image-wrapper">
        <div class="tape-sticker"></div>
        <img src="/image/avatar.png" alt="Dani Ramos Merino" class="hero-photo" width="400" height="400" fetchpriority="high" />
        <div class="deco-code">
          <svg width="100" height="100" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="6" y="6" width="88" height="88" rx="8" fill="#9d4edd" stroke="#000" stroke-width="4" />
            <rect x="3" y="3" width="88" height="88" rx="8" fill="#9d4edd" stroke="#000" stroke-width="4" />
            <path d="M35 40 L20 50 L35 60" stroke="#000" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M65 40 L80 50 L65 60" stroke="#000" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
            <line x1="55" y1="35" x2="45" y2="65" stroke="#000" stroke-width="5" stroke-linecap="round" />
          </svg>
        </div>
        <div class="deco-terminal">
          <svg width="100" height="100" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="6" y="6" width="88" height="88" rx="8" fill="#ff8c42" stroke="#000" stroke-width="4" />
            <rect x="3" y="3" width="88" height="88" rx="8" fill="#ff8c42" stroke="#000" stroke-width="4" />
            <path d="M25 35 L40 50 L25 65" stroke="#000" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
            <line x1="50" y1="65" x2="75" y2="65" stroke="#000" stroke-width="5" stroke-linecap="round" />
          </svg>
        </div>
        <div class="deco-floppy">
          <svg width="100" height="100" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="6" y="6" width="88" height="88" rx="8" fill="#c1ff72" stroke="#000" stroke-width="4" />
            <rect x="3" y="3" width="88" height="88" rx="8" fill="#c1ff72" stroke="#000" stroke-width="4" />
            <rect x="20" y="20" width="60" height="60" rx="3" fill="#ff8c42" stroke="#000" stroke-width="4" />
            <rect x="30" y="20" width="40" height="20" fill="#9d4edd" stroke="#000" stroke-width="3" />
            <rect x="35" y="55" width="30" height="15" rx="2" fill="#000" />
            <circle cx="50" cy="35" r="3" fill="#000" />
          </svg>
        </div>
        <div class="deco-label" data-i18n="hero.label">Full Stack Dev</div>
      </div>
    </div>
  </div>
  <div class="tech-badges">
    <span class="tech-badge"><i class="fab fa-php"></i> PHP</span>
    <span class="tech-badge"><i class="fab fa-js"></i> JavaScript</span>
    <span class="tech-badge"><i class="fab fa-react"></i> React</span>
    <span class="tech-badge"><i class="fab fa-node-js"></i> Node.js</span>
    <span class="tech-badge"><i class="fab fa-wordpress"></i> WordPress</span>
    <span class="tech-badge"><i class="fas fa-shopping-cart"></i> PrestaShop</span>
    <span class="tech-badge"><i class="fas fa-database"></i> SQL</span>
    <span class="tech-badge"><i class="fab fa-html5"></i> HTML5</span>
  </div>
</section>
